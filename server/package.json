{
  "name": "autoscanner-server",
  "version": "1.0.0",
  "description": "Backend API para AutoScanner com Node.js nativo, Express, TypeScript, Zod e Gemini AI",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "node --watch --experimental-strip-types server.ts",
    "start": "node --experimental-strip-types server.ts",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
